# Copy to .env.local and change these values
ADMIN_EMAIL=admin@mainbazar.local
ADMIN_PASSWORD=change-me-now
# Country code used when a phone number starts with 0 (92 = Pakistan, 91 = India)
DEFAULT_COUNTRY_CODE=92
CURRENCY=Rs
# Set to true once the site is served over HTTPS
COOKIE_SECURE=false

# --- Production on Vercel (leave empty for local development) ---
# Turso database. Without these, the app uses the local file data/mainbazar.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Vercel Blob image storage. Added automatically when you connect a Blob store
# to the Vercel project. Without it, images are saved to data/uploads
BLOB_READ_WRITE_TOKEN=
