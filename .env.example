# Copy to .env.local and change these values
# ADMIN_EMAIL is the admin login AND the address that gets "new seller" notifications
ADMIN_EMAIL=admin@mainbazar.local
ADMIN_PASSWORD=change-me-now
# Country code used when a phone number starts with 0 (92 = Pakistan, 91 = India)
DEFAULT_COUNTRY_CODE=92
CURRENCY=Rs
# Set to true once the site is served over HTTPS
COOKIE_SECURE=false

# --- Production on Vercel (leave empty for local development) ---
# Turso database. Without these, the app uses the local file data/mainbazar.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Vercel Blob image storage. Added automatically when you connect a Blob store
# to the Vercel project. Without it, images are saved to data/uploads
BLOB_READ_WRITE_TOKEN=

# --- Email (Nodemailer) for seller sign-up codes and admin/seller notifications ---
# Gmail: EMAIL_USER = your Gmail address, EMAIL_PASS = a 16-character App Password
# (Google Account > Security > 2-Step Verification > App passwords). Not your normal password.
# Leave empty in local development to print emails in the terminal instead.
EMAIL_USER=
EMAIL_PASS=
# Optional: use another SMTP server instead of Gmail
EMAIL_HOST=
EMAIL_PORT=587
# Optional: "From" header, e.g. MainBazar Haripur <no-reply@yourdomain.com>
EMAIL_FROM=
# Public site address used for links in emails, e.g. https://mainbazar-haripur.vercel.app
APP_URL=
